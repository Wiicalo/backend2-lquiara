            "sessions",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json && json.token) {",
              "    pm.environment.set('token', json.token);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
